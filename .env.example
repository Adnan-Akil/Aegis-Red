# ── Aegis-Red Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ── Groq API (Primary Attack LLM) ────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Groq API (Report Generator LLM) ──────────────────────────────────────────
# Can be the same key as GROQ_API_KEY, or a separate one for rate-limit isolation
REPORT_LLM_API_KEY=your_groq_report_api_key_here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL and service role key (for backend use only)
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── Backend Configuration ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# For local development, keep http://localhost:3000
# For production frontend, add your deployed Vercel/Netlify URL.
ALLOWED_ORIGINS=http://localhost:3000,https://aegis-red-vz8g.vercel.app

